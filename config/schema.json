{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "V2D Configuration",
  "description": "Configuration schema for V2D video dubbing system",
  "type": "object",
  "properties": {
    "system": {
      "type": "object",
      "properties": {
        "max_concurrent_jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1
        },
        "temp_directory": {
          "type": "string",
          "default": "data/jobs"
        },
        "log_level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
          "default": "INFO"
        },
        "log_retention_days": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        }
      },
      "additionalProperties": false
    },
    "gpu": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "pattern": "^(cuda(:\\d+)?|cpu)$",
          "default": "cuda:0"
        },
        "max_vram_usage_gb": {
          "type": "number",
          "minimum": 4,
          "maximum": 48,
          "default": 12
        },
        "prefer_fp16": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "properties": {
        "whisper": {
          "type": "object",
          "properties": {
            "model_size": {
              "type": "string",
              "enum": ["tiny", "base", "small", "medium", "large", "large-v2", "large-v3"],
              "default": "large-v3"
            },
            "compute_type": {
              "type": "string",
              "enum": ["float16", "float32", "int8", "int8_float16"],
              "default": "float16"
            },
            "beam_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 5
            },
            "vad_filter": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "demucs": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "default": "htdemucs"
            },
            "shifts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "default": 1
            },
            "overlap": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.99,
              "default": 0.25
            }
          },
          "additionalProperties": false
        },
        "marian": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "default": "Helsinki-NLP/opus-mt-ja-en"
            },
            "max_length": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048,
              "default": 512
            }
          },
          "additionalProperties": false
        },
        "tts": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "enum": ["xtts", "styletts2"],
              "default": "xtts"
            },
            "sample_rate": {
              "type": "integer",
              "enum": [16000, 22050, 24000, 44100, 48000],
              "default": 24000
            },
            "xtts": {
              "type": "object",
              "properties": {
                "model_version": {
                  "type": "string",
                  "default": "v2.0.2"
                }
              },
              "additionalProperties": false
            },
            "styletts2": {
              "type": "object",
              "properties": {
                "config_path": {
                  "type": "string",
                  "default": "StyleTTS2/Models/LJSpeech/config.yml"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["phase1", "phase2"]
          },
          "default": ["phase1"]
        },
        "extract_audio": {
          "type": "object",
          "properties": {
            "sample_rate": {
              "type": "integer",
              "enum": [16000, 22050, 24000, 44100, 48000],
              "default": 24000
            },
            "channels": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2,
              "default": 1
            },
            "format": {
              "type": "string",
              "enum": ["wav", "flac"],
              "default": "wav"
            }
          },
          "additionalProperties": false
        },
        "timing": {
          "type": "object",
          "properties": {
            "max_stretch_ratio": {
              "type": "number",
              "minimum": 1.0,
              "maximum": 2.0,
              "default": 1.3
            },
            "min_stretch_ratio": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.0,
              "default": 0.8
            },
            "target_silence_gap_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 200
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "properties": {
        "voice_cache_path": {
          "type": "string",
          "default": "data/cache/voices"
        },
        "model_cache_path": {
          "type": "string",
          "default": "data/cache/models"
        },
        "max_voice_cache_entries": {
          "type": "integer",
          "minimum": 10,
          "default": 1000
        },
        "voice_cache_ttl_days": {
          "type": "integer",
          "minimum": 1,
          "default": 90
        }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "auto_cleanup_on_success": {
          "type": "boolean",
          "default": true
        },
        "keep_checkpoints": {
          "type": "boolean",
          "default": false
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
